# Zerodha Kite Connect — never commit real values.
# KITE_API_KEY     = api_key from https://developers.kite.trade (not the secret)
# KITE_API_SECRET  = api_secret from the same app page (only used to exchange request_token)
# KITE_ACCESS_TOKEN = daily session token from generate_session — NOT the api_secret
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Local research data (Parquet). Relative paths are resolved from the working directory.
DATA_DIR=./data

# All session dates, expiry assumptions, and displayed timestamps use this zone.
TIMEZONE=Asia/Kolkata

# Continuously compounded risk-free rate as a decimal (e.g. 0.065 = 6.5%).
# Leave empty to skip IV/Greeks until you pass --risk-free-rate on the CLI.
RISK_FREE_RATE=

# --- Optional tuning (defaults are conservative and documented in README) ---
# QUOTE_BATCH_SIZE=500
# STALE_QUOTE_SECONDS=120
# IV_VOL_LOWER=0.000001
# IV_VOL_UPPER=5.0
# OPTION_EXPIRY_TIME=23:30:00
# SECONDS_PER_YEAR=31557600
# WEBSOCKET_RECONNECT_MAX_TRIES=10
# WEBSOCKET_RECONNECT_MAX_DELAY=60
# LOG_LEVEL=INFO
