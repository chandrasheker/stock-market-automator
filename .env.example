# Zerodha Kite Connect (get from https://kite.trade/connect/login)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=

# Trading mode: paper | live
TRADING_MODE=paper

# Personal capital for position sizing (INR)
CAPITAL=500000

# Risk limits
MAX_RISK_PER_TRADE_PCT=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=3
PROFIT_TARGET_PCT=20.0
STOP_LOSS_PCT=15.0

# Optional: NewsAPI key for enhanced news (https://newsapi.org)
NEWS_API_KEY=

# Dashboard
DASHBOARD_PORT=8501
SECRET_KEY=change-this-to-a-random-string

# TradingView webhook (alerts → bot execution)
TRADINGVIEW_WEBHOOK_SECRET=change-this-to-a-long-random-string
WEBHOOK_PORT=8765
WEBHOOK_HOST=0.0.0.0
# Full URL shown in dashboard, e.g. http://YOUR_VM_IP:8765/webhook/tradingview
PUBLIC_WEBHOOK_URL=
